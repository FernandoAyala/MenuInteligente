{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2020",
    "lib": ["ES2020"],
    "ignoreDeprecations": "5.0"
  },
  "include": [
    "vite.config.ts",
    "postcss.config.js",
    "tailwind.config.js"
  ]
}