{
  "name": "menu-inteligente",
  "version": "1.0.0",
  "description": "Sistema de mozo virtual conversacional con IA",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\" --names \"backend,frontend\" --prefix-colors \"blue,magenta\"",
    "build": "tsc --project tsconfig.server.json",
    "build:frontend": "vite build",
    "build:all": "npm run build && npm run build:frontend",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "seed": "ts-node src/scripts/seed-menu.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "jest --testPathPattern=src/tests/e2e",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "health-check": "curl -f http://localhost:3000/health || exit 1",
    "setup": "bash scripts/setup.sh",
    "deploy": "bash scripts/deploy.sh",
    "docker:build": "docker build -t menu-inteligente .",
    "docker:run": "docker-compose up",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:stop": "docker-compose down",
    "clean": "rm -rf node_modules dist package-lock.json && npm install",
    "logs": "tail -f logs/app.log",
    "azure:up": "azd up",
    "azure:down": "azd down",
    "azure:logs": "azd logs",
    "azure:monitor": "azd monitor",
    "typecheck": "tsc --noEmit --project tsconfig.server.json",
    "prebuild": "npm run typecheck && npm run lint",
    "prestart": "npm run build",
    "pretest": "npm run typecheck",
    "server:dev": "ts-node-dev --respawn --transpile-only --project tsconfig.server.json src/index.ts",
    "server:build": "tsc --project tsconfig.server.json",
    "server:start": "node dist/index.js",
    "server:seed": "ts-node src/scripts/seed-menu.ts",
    "server:seed:menu": "tsx src/scripts/create-test-menu-items.ts",
    "server:seed:order": "tsx src/scripts/create-test-order.ts",
    "server:seed:cart": "tsx src/scripts/create-test-session-with-cart.ts",
    "server:add-to-cart": "tsx src/scripts/add-item-to-cart.ts",
    "server:lint": "eslint . --ext .ts",
    "server:format": "prettier --write \"src/**/*.ts\"",
    "server:test": "jest",
    "server:test:watch": "jest --watch",
    "client:dev": "vite",
    "client:build": "tsc && vite build",
    "client:preview": "vite preview",
    "client:lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "client:test": "jest",
    "client:test:watch": "jest --watch",
    "client:dev:admin": "vite --mode admin",
    "client:dev:client": "vite --mode client",
    "client:dev:all": "concurrently \"npm run client:dev:admin\" \"npm run client:dev:client\" --names \"admin,client\" --prefix-colors \"cyan,green\"",
    "cliente:dev": "vite --open /cliente.html",
    "cliente:build": "vite build --mode cliente && move dist-cliente\\cliente.html dist-cliente\\index.html",
    "cocina:dev": "vite --open /cocina.html --port 5175",
    "cocina:build": "vite build --mode cocina && move dist-cocina\\cocina.html dist-cocina\\index.html",
    "deploy:cliente": "npm run cliente:build && firebase deploy --only hosting:cliente",
    "deploy:cocina": "npm run cocina:build && firebase deploy --only hosting:cocina",
    "deploy:frontend": "npm run cliente:build && npm run cocina:build && firebase deploy --only hosting",
    "deploy:all": "npm run deploy:frontend"
  },
  "keywords": [
    "chatbot",
    "ai",
    "restaurant",
    "conversational-ai"
  ],
  "author": "Grupo 8 - IAA",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^0.3.0",
    "@tanstack/react-query": "^5.8.4",
    "axios": "^1.12.2",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "lucide-react": "^0.292.0",
    "openai": "^4.24.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.6.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^4.1.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.31",
    "prettier": "^3.2.4",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.3.5",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "vite": "^4.5.0"
  }
}
