# =================================
# CONFIGURACIÓN DEL SERVIDOR
# =================================

# Entorno de ejecución (development, production, test)
NODE_ENV=development

# Puerto donde se ejecuta la aplicación
PORT=3000

# URL base de la aplicación
BASE_URL=http://localhost:3000

# =================================
# CONFIGURACIÓN DE FIREBASE
# =================================

# ID del proyecto de Firebase (REQUERIDO)
FIREBASE_PROJECT_ID=your-project-id

# Ruta al archivo de credenciales de servicio
GOOGLE_APPLICATION_CREDENTIALS=./config/serviceAccountKey.json

# Firebase Emulator para desarrollo local
FIREBASE_EMULATOR_HOST=localhost:8080

# =================================
# CONFIGURACIÓN DE LLM PROVIDERS
# =================================

# Clave API de OpenAI (REQUERIDA para provider openai)
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Clave API de Google Gemini (REQUERIDA para provider gemini)  
# Obtener en: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Proveedor LLM por defecto: 'openai' | 'gemini'
LLM_DEFAULT_PROVIDER=openai

# Configuración específica de OpenAI
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1500
OPENAI_TEMPERATURE=0.7

# Configuración específica de Gemini
GEMINI_MODEL=gemini-pro
GEMINI_MAX_TOKENS=1500

# =================================
# CONFIGURACIÓN DE CORS Y SEGURIDAD
# =================================

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Secret para JWT (cambiar en producción)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Tiempo de expiración de JWT
JWT_EXPIRES_IN=7d

# =================================
# CONFIGURACIÓN DE RATE LIMITING
# =================================

# Ventana de tiempo para rate limiting (en milisegundos)
RATE_LIMIT_WINDOW_MS=900000

# Máximo de requests por ventana de tiempo
RATE_LIMIT_MAX_REQUESTS=100

# Rate limiting específico para recomendaciones
RECOMMENDATIONS_RATE_LIMIT_WINDOW_MS=60000
RECOMMENDATIONS_RATE_LIMIT_MAX_REQUESTS=20

# =================================
# CONFIGURACIÓN DE REDIS (CACHE)
# =================================

# URL de conexión a Redis
REDIS_URL=redis://localhost:6379

# Base de datos Redis (0-15)
REDIS_DB=0

# TTL por defecto para cache (en segundos)
CACHE_TTL=3600

# Prefijo para keys de cache
CACHE_PREFIX=menu_inteligente:

# =================================
# CONFIGURACIÓN DE LOGGING
# =================================

# Nivel de logging (error, warn, info, debug)
LOG_LEVEL=info

# Formato de logs (json, simple)
LOG_FORMAT=json

# Directorio para archivos de log
LOG_DIR=./logs

# =================================
# CONFIGURACIÓN DE MONITORING
# =================================

# Habilitar métricas de Application Insights
ENABLE_METRICS=true

# Connection string de Application Insights (Azure)
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://your-region.in.applicationinsights.azure.com/

# Sampling rate para telemetría (0.0 - 1.0)
APPINSIGHTS_SAMPLING_RATE=0.1

# =================================
# CONFIGURACIÓN DE AZURE KEY VAULT (PRODUCCIÓN)
# =================================

# URL del Key Vault para secretos en producción
# KEY_VAULT_URL=https://your-keyvault.vault.azure.net/

# =================================
# CONFIGURACIÓN DE SOCKET.IO
# =================================

# Configuración de CORS para Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Namespace de Socket.IO para chat
SOCKET_NAMESPACE=/chat

# =================================
# CONFIGURACIÓN DE NEGOCIO
# =================================

# Idioma por defecto para respuestas
DEFAULT_LANGUAGE=es

# Número máximo de recomendaciones por respuesta
MAX_RECOMMENDATIONS=5

# Umbral mínimo de confianza para recomendaciones (0.0 - 1.0)
MIN_CONFIDENCE_THRESHOLD=0.6

# Habilitar filtros de seguridad alimentaria
ENABLE_ALLERGY_FILTERS=true

# Lista de alérgenos monitoreados (separados por coma)
MONITORED_ALLERGENS=gluten,lácteos,nueces,mariscos,huevo,soja

# =================================
# CONFIGURACIÓN DEL FRONTEND (VITE)
# =================================

# URL base de la API backend
VITE_API_URL=http://localhost:3000

# URL del servidor WebSocket para chat en tiempo real
VITE_WS_URL=http://localhost:3000

# =================================
# CONFIGURACIÓN DE DESARROLLO
# =================================

# Habilitar modo debug detallado
DEBUG=false

# Habilitar hot reload en desarrollo
HOT_RELOAD=true

# Mostrar stack traces completos en errores
SHOW_STACK_TRACES=true

# Cargar datos de prueba al iniciar
SEED_DATA=true

# =================================
# CONFIGURACIÓN DE PRODUCCIÓN
# =================================

# Número de workers para cluster (0 = auto-detect CPUs)
CLUSTER_WORKERS=0

# Timeout para requests (en milisegundos)
REQUEST_TIMEOUT=30000

# Máximo tamaño de body de request
MAX_BODY_SIZE=1mb

# Habilitar compresión gzip
ENABLE_COMPRESSION=true

# =================================
# CONFIGURACIÓN DE TESTS
# =================================

# Proyecto Firebase para testing
TEST_FIREBASE_PROJECT_ID=demo-test-project

# Timeout para tests (en milisegundos)
TEST_TIMEOUT=10000

# =================================
# CONFIGURACIÓN REGIONAL
# =================================

# Timezone de la aplicación
TZ=America/Argentina/Buenos_Aires

# Moneda por defecto
DEFAULT_CURRENCY=ARS

# =================================
# CONFIGURACIÓN DE NOTIFICACIONES (OPCIONAL)
# =================================

# Webhook para notificaciones de Slack
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Configuración de emails para alertas
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
